# Copie este arquivo para .env.local no seu computador ou para .env no servidor.
#
# Use SEMPRE a chave publishable/anon no app. A service_role/secret dá acesso
# total ao banco e só pode existir no servidor, para o worker de e-mail.
#
# As variáveis do Supabase são lidas pelo servidor em /api/config a cada
# requisição, por isso não levam NEXT_PUBLIC_ e não entram no bundle do cliente.
# Trocar os valores no host não exige rebuild: basta recriar o container.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA-CHAVE-PUBLICA

# Opcionais, usadas apenas pelo docker compose:
# APP_PORT=3000        # porta publicada no host
# APP_BIND=0.0.0.0     # use 127.0.0.1 quando houver proxy reverso
# DOMAIN=estokar.seudominio.com
# CLOUDFLARE_TUNNEL_TOKEN=...  # só para túnel nomeado permanente

# E-mail de fornecedor (opcional).
# Use uma senha de app do provedor, nunca a senha principal.
# EMAIL_INGESTION_SECRET=um-segredo-forte
# EMAIL_IMAP_HOST=imap.seuprovedor.com
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_SECURE=true
# EMAIL_IMAP_USER=notas@seudominio.com
# EMAIL_IMAP_PASSWORD=sua-senha-de-app
# EMAIL_IMAP_MAILBOX=INBOX

# Necessário para o worker IMAP gravar os XMLs pendentes no Supabase.
# Esta chave fica SOMENTE no servidor; nunca a exponha no navegador.
# SUPABASE_SERVICE_ROLE_KEY=...
# EMAIL_IMAP_BUSINESS_ID=id-do-negocio
