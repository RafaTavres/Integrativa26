# Copie este arquivo para .env.local no seu computador ou para .env no servidor.
#
# Use SEMPRE a chave publishable/anon. A service_role/secret dá acesso total ao
# banco e nunca deve estar no navegador nem em uma variável pública.
#
# Estas variáveis são lidas pelo servidor em /api/config a cada requisição, por
# isso não levam o prefixo NEXT_PUBLIC_ e não entram no bundle do cliente.
# Trocar os valores no host não exige rebuild: basta recriar o container.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA-CHAVE-PUBLICA

# Opcionais, usadas apenas pelo docker compose:
# APP_PORT=3000        # porta publicada no host
# APP_BIND=0.0.0.0     # use 127.0.0.1 quando houver proxy reverso
