# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
#
# Use SEMPRE a chave publishable/anon. A service_role/secret dá acesso total ao
# banco e nunca deve estar no navegador nem em uma variável pública.
#
# Estas variáveis são lidas pelo servidor em /api/config a cada requisição, por
# isso não levam o prefixo NEXT_PUBLIC_ e não entram no bundle do cliente.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA-CHAVE-PUBLICA
